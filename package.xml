<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feeding_deployment</name>
  <version>0.0.0</version>
  <description>The feeding_deployment package</description>

  <maintainer email="yyt@todo.todo">yyt</maintainer>
  <license>TODO</license>

  <!-- ROS1 -> ROS2 dependency mapping (see ROS2_MIGRATION_NOTES.md):
         roscpp, rospy  -> rclpy   (pure-Python package now; no first-party
                                     C++ nodes exist in this repo, so roscpp
                                     is dropped rather than mapped 1:1)
         rviz           -> rviz2   (confirmed available: apt package
                                     ros-jazzy-rviz2, ROS package name
                                     "rviz2")
       Added because the code actually uses them (grep-confirmed) even
       though the ROS1 package.xml never declared them explicitly:
         tf2_ros was already declared; also add message_filters, cv_bridge
         (both used by realsense_interface.py / head_perception/ros_wrapper.py
         / drink_manipulation_test.py), launch + launch_ros (needed to run
         the new *.launch.py files), rosbridge_suite (webapp-facing
         rosbridge server; confirmed available on Jazzy: apt package
         ros-jazzy-rosbridge-suite, same wire protocol as ROS1's
         rosbridge_suite per the task brief), and feeding_deployment_msgs
         (custom srv package, was only an exec_depend before; kept as
         exec_depend since nothing in this package's own interfaces
         depends on it at build/generation time).
       DROPPED per an explicit scope-change instruction mid-migration (see
       ROS2_MIGRATION_NOTES.md's "Scope change" section): rplidar_ros. It
       is lidar/mobile-base hardware, out of scope now that this migration
       is arm/manipulation-only; the wheelchair base is separately
       documented as parked/unpowered/out of scope. rplidar_ros WAS
       confirmed available for Jazzy (same package name, apt package
       ros-jazzy-rplidar-ros) before being dropped here; removed for
       scope reasons, not because it was unavailable.
  -->
  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbridge_suite</exec_depend>
  <exec_depend>feeding_deployment_msgs</exec_depend>
  <exec_depend>python3-pygame</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
